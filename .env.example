# Frontend → proxy Next.js vers FastAPI
API_URL=http://127.0.0.1:8000

# Base de données. Vide : SQLite dans apps/api/data/meridian.db (rien à installer).
# PostgreSQL : DATABASE_URL=postgresql://geo:geo@localhost:5432/geo (docker compose up -d)
DATABASE_URL=
# Crée le compte démo (demo@geo.dev) au démarrage. Mettre false en production.
SEED_DEMO=true

# Redis / Celery. Laisser vide pour exécuter le suivi dans le process API.
REDIS_URL=redis://localhost:6379/0
ASYNC_TASKS=false

# auto : interroge le moteur si un accès existe (DataForSEO ou clé directe), sinon simule la réponse.
# true : toujours simuler. false : toujours appeler (échec si aucun accès).
MOCK_LLM=auto

# DataForSEO interroge tous les moteurs : ChatGPT et Gemini tels que les utilisateurs les voient,
# Google AI Overviews et AI Mode, Perplexity et Claude. Identifiants : tableau de bord DataForSEO, « API Access ».
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Pays des réponses (FR, BE, CH, CA, LU, US, GB, NL, DE, ES, IT, SA) et langue si la question ne la trahit pas.
DATAFORSEO_COUNTRY=FR
DATAFORSEO_LANGUAGE=fr
CLAUDE_MODEL=claude-sonnet-5-5
PERPLEXITY_MODEL=sonar

# Appels directs, sans DataForSEO (développement) : ChatGPT par l'API GPT-4o, Perplexity, Gemini et AI Studio.
# Claude passe alors par ANTHROPIC_API_KEY.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Analyse des réponses (marques nommées, rang, ton) par Claude. Sans clé : analyse par mots-clés.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-haiku-5-5
# auto : analyse par Claude dès que la clé est présente. false : toujours par mots-clés.
ANALYSIS_LLM=auto

# true : rendre les pages avec Chromium si le HTML statique est vide.
USE_PLAYWRIGHT=false

GEO_SECRET=change-me

# Liens dans les e-mails de confirmation et de mot de passe oublié.
# Sur Railway, laisser vide : le domaine public du service est utilisé.
APP_URL=http://localhost:3000

# Envoi des e-mails via Resend (HTTPS). Railway bloque les ports SMTP.
# Sans RESEND_API_KEY, l'inscription et le mot de passe oublié répondent que l'envoi n'est pas configuré.
# Sans domaine vérifié, laissez RESEND_FROM vide : Resend n'envoie alors qu'à l'adresse du compte, depuis onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=

# Comptes administrateurs, un par collaborateur, séparés par un point-virgule.
# Format : Nom|email|motdepasse
# Le mot de passe fait au moins 8 caractères, avec une lettre et un chiffre, et ne contient pas de point-virgule.
# Au redémarrage, le compte est créé s'il n'existe pas. S'il existe déjà, il devient administrateur et prend ce mot de passe.
# ADMIN_ACCOUNTS=Maxime|maxime@example.com|change-me8;Valentin|valentin@example.com|change-me8
ADMIN_ACCOUNTS=

# Stripe. sk_test_ envoie le client vers l'environnement de test, sk_live_ vers les vrais paiements.
# Les price_ sont les prix mensuels créés dans le même environnement.
# STRIPE_WEBHOOK_SECRET vient du webhook pointant vers https://<domaine>/api/geo/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_CROISSANCE=
STRIPE_PRICE_REFERENCE=
