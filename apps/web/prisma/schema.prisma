generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String      @map("password_hash")
  createdAt    DateTime    @default(now()) @map("created_at")
  workspaces   Workspace[]

  @@map("users")
}

model Workspace {
  id           String        @id @default(cuid())
  name         String
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")
  brand        Brand?
  competitors  Competitor[]
  queries      Query[]
  trackingRuns TrackingRun[]
  audits       Audit[]

  @@map("workspaces")
}

model Brand {
  id          String    @id @default(cuid())
  workspaceId String    @unique @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  domain      String
  sector      String

  @@map("brands")
}

model Competitor {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  domain      String

  @@unique([workspaceId, domain])
  @@map("competitors")
}

model Query {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prompt      String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("queries")
}

model TrackingRun {
  id           String     @id @default(cuid())
  workspaceId  String     @map("workspace_id")
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  queryId      String     @map("query_id")
  queryPrompt  String     @map("query_prompt")
  provider     String
  model        String
  status       String
  source       String
  responseText String     @map("response_text") @db.Text
  error        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  citations    Citation[]
  mentions     Mention[]

  @@index([workspaceId, createdAt])
  @@map("tracking_runs")
}

model Citation {
  id            String      @id @default(cuid())
  trackingRunId String      @map("tracking_run_id")
  trackingRun   TrackingRun @relation(fields: [trackingRunId], references: [id], onDelete: Cascade)
  url           String
  domain        String
  title         String?
  position      Int

  @@map("citations")
}

model Mention {
  id            String      @id @default(cuid())
  trackingRunId String      @map("tracking_run_id")
  trackingRun   TrackingRun @relation(fields: [trackingRunId], references: [id], onDelete: Cascade)
  entityName    String      @map("entity_name")
  entityType    String      @map("entity_type")
  position      Int
  sentiment     Float
  excerpt       String

  @@map("mentions")
}

model Audit {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url             String
  score           Int
  headingScore    Int       @map("heading_score")
  schemaScore     Int       @map("schema_score")
  factualScore    Int       @map("factual_score")
  crawlerScore    Int       @map("crawler_score")
  findings        Json
  recommendations Json
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("audits")
}
